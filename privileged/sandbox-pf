#!/bin/bash
# The only privileged entry point for the sandbox tool. Installed root-owned at
# /usr/local/libexec/sandbox-pf. Commands, all for one sandbox anchor:
#
#   load <name> <subnet> <gateway> <bridge> <port> <mode> <vnc-port|none> [cidr ...]
#         mode: web | network | both | both-open. The CIDR list is only used for network and both.
#         vnc-port: lets the Mac (the sandbox gateway) reach the sandbox's VNC server on that port.
#   show <name>
#   flush <name>
#   capture-start <name> <logfile>   records pf log entries for the sandbox to <logfile>
#   capture-stop <name> <pidfile>
set -euo pipefail
PATH=/sbin:/usr/sbin:/bin:/usr/bin

die() { echo "sandbox-pf: $*" >&2; exit 2; }

cmd="${1:-}"
name="${2:-}"
[[ "$name" =~ ^[a-z0-9][a-z0-9-]{0,60}$ ]] || die "invalid sandbox name"
anchor="com.apple/sandbox-$name"

case "$cmd" in
  load)
    subnet="${3:-}"; gateway="${4:-}"; bridge="${5:-}"; port="${6:-}"; mode="${7:-}"; vnc="${8:-}"
    [[ "$subnet" =~ ^192\.168\.(20[0-9]|2[1-4][0-9]|250)\.0/24$ ]] || die "subnet outside the sandbox pool"
    [[ "$gateway" == "${subnet%.0/24}.1" ]] || die "gateway does not match subnet"
    [[ "$bridge" =~ ^bridge[0-9]{1,4}$ ]] || die "invalid bridge name"
    [[ "$port" == "3128" ]] || die "invalid proxy port"
    case "$mode" in web|network|both|both-open) ;; *) die "invalid mode" ;; esac
    [[ "$vnc" == "none" || ( "$vnc" =~ ^[0-9]{1,5}$ && 10#$vnc -ge 1 && 10#$vnc -le 65535 ) ]] || die "invalid VNC port"

    /sbin/ifconfig pflog0 >/dev/null 2>&1 || /sbin/ifconfig pflog0 create

    rules=""
    if [[ "$mode" != "network" ]]; then
      rules="pass quick on $bridge proto tcp from $subnet to $gateway port $port keep state"
    fi
    rules+=$'\n'"block drop log quick on $bridge proto udp from $subnet to any port 53"
    if [[ "$vnc" != "none" ]]; then
      rules+=$'\n'"pass quick on $bridge proto tcp from $gateway to $subnet port $vnc keep state"
    fi

    if [[ "$mode" != "web" ]]; then
      for cidr in "${@:9}"; do
        [[ "$cidr" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$ ]] || die "invalid address entry: $cidr"
        IFS=./ read -r o1 o2 o3 o4 pfx <<< "$cidr"
        for o in "$o1" "$o2" "$o3" "$o4"; do
          (( 10#$o <= 255 )) || die "invalid address entry: $cidr"
        done
        if [[ "$cidr" != "0.0.0.0/0" ]]; then
          (( 10#$pfx >= 8 )) || die "address entry too broad: $cidr"
        fi
        [[ "$o1.$o2.$o3" != "${subnet%.0/24}" ]] || die "address entry overlaps the sandbox subnet: $cidr"
        if [[ "$cidr" == "0.0.0.0/0" ]]; then
          while read -r own_ip; do
            rules+=$'\n'"block drop quick on $bridge from $subnet to $own_ip"
          done < <(ifconfig | awk '$1=="inet"{print $2}')
        fi
        block_web=0
        [[ "$mode" == "both" ]] && block_web=1
        [[ "$mode" == "both-open" && "$cidr" != "0.0.0.0/0" ]] && block_web=1
        if [[ $block_web -eq 1 ]]; then
          rules+=$'\n'"block drop log quick on $bridge proto tcp from $subnet to $cidr port { 80 443 }"
        fi
        rules+=$'\n'"pass log quick on $bridge proto { tcp udp } from $subnet to $cidr keep state"
        rules+=$'\n'"pass log quick on $bridge proto icmp from $subnet to $cidr"
      done
    fi

    rules+=$'\n'"block drop log quick on $bridge from $subnet to any"
    printf '%s\n' "$rules" | /sbin/pfctl -a "$anchor" -f -
    ;;
  show)
    /sbin/pfctl -a "$anchor" -sr
    ;;
  flush)
    /sbin/pfctl -a "$anchor" -F rules
    ;;
  capture-start)
    logfile="${3:-}"
    owner="${SUDO_USER:-}"
    [[ -n "$owner" && "$owner" != "root" ]] || die "capture must be started through sudo"
    [[ "$logfile" == /*/.sandbox/sandboxes/"$name"/pflog.txt ]] || die "invalid log path"
    [[ "$logfile" != *..* ]] || die "invalid log path"
    [[ ! -L "$logfile" && ! -L "$(dirname "$logfile")" ]] || die "log path must not be a symlink"
    [[ "$(stat -f %Su "$(dirname "$logfile")")" == "$owner" ]] || die "log folder must belong to $owner"
    pidfile="$(dirname "$logfile")/capture.pid"
    [[ -f "$pidfile" ]] && kill "$(cat "$pidfile")" 2>/dev/null || true
    /sbin/ifconfig pflog0 >/dev/null 2>&1 || /sbin/ifconfig pflog0 create
    : > "$logfile"
    chown "$owner" "$logfile"
    /usr/sbin/tcpdump -i pflog0 -n -e -l > "$logfile" 2>/dev/null &
    echo $! > "$pidfile"
    chown "$owner" "$pidfile"
    ;;
  capture-stop)
    pidfile="${3:-}"
    owner="${SUDO_USER:-}"
    [[ -n "$owner" && "$owner" != "root" ]] || die "capture-stop must be run through sudo"
    [[ "$pidfile" == /*/.sandbox/sandboxes/"$name"/capture.pid ]] || die "invalid pid path"
    [[ "$pidfile" != *..* ]] || die "invalid pid path"
    [[ ! -L "$pidfile" ]] || die "pid path must not be a symlink"
    if [[ -f "$pidfile" ]]; then
      kill "$(cat "$pidfile")" 2>/dev/null || true
      rm -f "$pidfile"
    fi
    ;;
  *)
    die "usage: sandbox-pf load|show|flush|capture-start|capture-stop <name> [...]"
    ;;
esac
