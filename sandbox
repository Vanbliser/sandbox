#!/usr/bin/env bash
set -euo pipefail

SANDBOX_HOME="${SANDBOX_HOME:-$HOME/.sandbox}"
CA_DIR="$SANDBOX_HOME/ca"
BIN_DIR="$SANDBOX_HOME/bin"
PROJECTS_FILE="$SANDBOX_HOME/projects"
PROXY_PORT=3128
SANDBOX_IMAGE="${SANDBOX_IMAGE:-sandbox-base:latest}"
PF_HELPER=/usr/local/libexec/sandbox-pf

resolve_script_dir() {
  local p="$1" d
  while [[ -L "$p" ]]; do
    d="$(cd "$(dirname "$p")" && pwd)"
    p="$(readlink "$p")"
    [[ "$p" == /* ]] || p="$d/$p"
  done
  cd "$(dirname "$p")" && pwd
}
SCRIPT_DIR="$(resolve_script_dir "${BASH_SOURCE[0]}")"
DEFAULTS_FILE="$SCRIPT_DIR/defaults.txt"

# Set by resolve_project (project commands) and set_sandbox_names (per sandbox).
PROJECT_ROOT="" PROJECT_NAME="" SB_BASE=""
NAME="" DIR=""

die() { echo "sandbox: $*" >&2; exit 1; }

ensure_brew_pkg() {
  local bin="$1" pkg="$2"
  command -v "$bin" >/dev/null 2>&1 && return 0
  command -v brew >/dev/null 2>&1 \
    || die "missing '$bin' and Homebrew is not installed; install Homebrew from https://brew.sh then rerun"
  read -r -p "'$bin' is missing. Install '$pkg' with Homebrew now? [y/N] " answer
  [[ "$answer" =~ ^[Yy]$ ]] || die "'$bin' is required; install it and rerun"
  brew install "$pkg" || die "brew install $pkg failed"
  command -v "$bin" >/dev/null 2>&1 || die "'$bin' still not found after install"
}

json_field() {
  grep -o "\"$2\": \"[^\"]*\"" "$1" | head -1 | cut -d'"' -f4
}

# ---------------------------------------------------------------- projects

sanitize_name() {
  printf '%s' "$1" | tr 'A-Z' 'a-z' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

resolve_project() {
  local d="$PWD"
  while :; do
    if [[ -f "$d/.sandbox/project.json" ]]; then
      PROJECT_ROOT="$d"
      PROJECT_NAME="$(json_field "$d/.sandbox/project.json" name)"
      SB_BASE="$d/.sandbox/sandboxes"
      return 0
    fi
    [[ "$d" == "/" ]] && break
    d="$(dirname "$d")"
  done
  die "this folder is not inside a sandbox project. Run 'sandbox init' in your project folder first"
}

# Sets NAME (project-sandbox) and DIR for a sandbox given its short name.
set_sandbox_names() {
  local short="$1"
  [[ "$short" =~ ^[a-z0-9][a-z0-9-]{0,40}$ ]] \
    || die "sandbox name '$short' must be lowercase letters, digits and hyphens"
  NAME="$PROJECT_NAME-$short"
  [[ ${#NAME} -le 50 ]] || die "the name '$NAME' is too long: project and sandbox names together must be 50 characters or fewer"
  DIR="$SB_BASE/$NAME"
}

require_sandbox() {
  set_sandbox_names "${1:-}"
  [[ -f "$DIR/state.json" ]] || die "no running sandbox named '$1' in this project"
}

cmd_init() {
  [[ -f "$CA_DIR/ca.crt" && -f "$BIN_DIR/sbx_addon.py" ]] \
    || die "this Mac isn't set up yet. Run: sudo ./install.sh"
  local here="$PWD" a pname
  if [[ -f "$here/.sandbox/project.json" ]]; then
    die "this folder is already a sandbox project ('$(json_field "$here/.sandbox/project.json" name)'). Create sandboxes with: sandbox up <name>"
  fi
  a="$(dirname "$here")"
  while [[ "$a" != "/" ]]; do
    if [[ -f "$a/.sandbox/project.json" ]]; then
      die "this folder is inside the sandbox project at $a. Run sandbox commands there, or init a project elsewhere"
    fi
    a="$(dirname "$a")"
  done
  pname="$(sanitize_name "$(basename "$here")")"
  [[ -n "$pname" ]] || die "could not make a project name from the folder name '$(basename "$here")'"
  [[ ${#pname} -le 30 ]] || die "the project name '$pname' is too long (30 characters at most)"

  mkdir -p "$here/.sandbox/sandboxes"
  printf '{\n  "name": "%s",\n  "created": "%s"\n}\n' "$pname" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$here/.sandbox/project.json"
  cat > "$here/.sandbox/.gitignore" <<'EOF'
# Commit the lists and settings. Ignore what the tool generates and what changes at runtime.
sandboxes/*/state.json
sandboxes/*/domains.txt
sandboxes/*/ips.txt
sandboxes/*/env
sandboxes/*/browser/
sandboxes/*/sessions/
sandboxes/*/mitm/
sandboxes/*/*.log
sandboxes/*/*.out
sandboxes/*/*.pid
sandboxes/*/pflog.txt
archive/
failed/
EOF
  mkdir -p "$SANDBOX_HOME"
  grep -qxF "$here" "$PROJECTS_FILE" 2>/dev/null || echo "$here" >> "$PROJECTS_FILE"
  echo "created sandbox project '$pname' in $here"
  echo "next: sandbox up <name> [-d <domains-file>] [-i <ips-file>]"
}

# ---------------------------------------------------------------- machine setup

write_helper() {
  mkdir -p "$BIN_DIR"

  # The proxy addon: enforces the lists and records headers and cookies. It runs with mitmproxy.
  cp "$SCRIPT_DIR/addon/sbx_addon.py" "$BIN_DIR/sbx_addon.py"
  chmod 644 "$BIN_DIR/sbx_addon.py"
}

export_trusted_roots() {
  local ctx="$1" out="$1/trusted-roots" pem
  pem="$(mktemp)"
  rm -rf "$out"
  mkdir -p "$out"
  local kc
  for kc in /System/Library/Keychains/SystemRootCertificates.keychain \
            /Library/Keychains/System.keychain \
            "$HOME/Library/Keychains/login.keychain-db"; do
    [[ -f "$kc" ]] && security find-certificate -a -p "$kc" >> "$pem" 2>/dev/null || true
  done
  awk -v dir="$out" '
    /BEGIN CERTIFICATE/ { n++; f = sprintf("%s/root-%04d.crt", dir, n) }
    f { print > f }
    /END CERTIFICATE/ { close(f); f = "" }
  ' "$pem"
  rm -f "$pem"
  cp "$CA_DIR/ca.crt" "$out/sandbox-ca.crt"
  echo "exported $(ls "$out" | wc -l | tr -d ' ') trusted roots from this Mac"
}

# Downloads Playwright 1.59.1 (the version numasec pins) and its Chromium into the build context, for Linux
# in this Mac's architecture. Later builds reuse the download.
stage_playwright() {
  local pw="$1/pw" ver="1.59.1" platform
  [[ -d "$pw/ms-playwright" && -f "$pw/playwright-core-$ver.tgz" ]] && return 0
  case "$(uname -m)" in
    arm64) platform="ubuntu24.04-arm64" ;;
    x86_64) platform="ubuntu24.04-x64" ;;
    *) die "no Playwright build for $(uname -m)" ;;
  esac
  mkdir -p "$pw"
  echo "downloading Playwright $ver and Chromium for $platform (about 1 GB, once)..."
  curl -sS --retry 3 -m 300 -o "$pw/playwright-core-$ver.tgz" \
    "https://registry.npmjs.org/playwright-core/-/playwright-core-$ver.tgz" \
    || die "could not download playwright-core $ver from the npm registry"
  rm -rf "$pw/package"
  tar -xzf "$pw/playwright-core-$ver.tgz" -C "$pw" || die "could not unpack playwright-core $ver"
  PLAYWRIGHT_BROWSERS_PATH="$pw/ms-playwright" PLAYWRIGHT_HOST_PLATFORM_OVERRIDE="$platform" \
    node "$pw/package/cli.js" install chromium >"$pw/install.log" 2>&1 \
    || die "could not download Chromium for Playwright; see $pw/install.log"
}

build_image() {
  local ctx="$SANDBOX_HOME/image"
  mkdir -p "$ctx"
  stage_playwright "$ctx"
  export_trusted_roots "$ctx"
  cat "$ctx"/trusted-roots/*.crt > "$ROOTS_PEM"
  cat > "$ctx/Containerfile" <<'EOF'
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates nodejs npm nmap netcat-openbsd libnss3-tools xvfb x11vnc novnc websockify \
 && rm -rf /var/lib/apt/lists/*
# Playwright 1.59.1 is the version numasec pins. It and its Chromium are staged on the Mac (stage_playwright),
# so the build doesn't depend on the npm registry.
COPY pw/ /opt/pw/
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/pw/ms-playwright
RUN npm install -g /opt/pw/playwright-core-1.59.1.tgz \
 && node /opt/pw/package/cli.js install-deps chromium \
 && rm -rf /var/lib/apt/lists/*
COPY trusted-roots/ /usr/local/share/ca-certificates/
RUN update-ca-certificates
# Chromium on Linux reads its own NSS database, not the system bundle. Import the same roots so the browser trusts them.
RUN mkdir -p /root/.pki/nssdb && certutil -d sql:/root/.pki/nssdb -N --empty-password \
 && for f in /usr/local/share/ca-certificates/*.crt; do certutil -d sql:/root/.pki/nssdb -A -t "C,," -n "$(basename "$f")" -i "$f"; done
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
EOF
  echo "building image $SANDBOX_IMAGE (this takes a few minutes the first time)"
  container build -t "$SANDBOX_IMAGE" -f "$ctx/Containerfile" "$ctx" >"$ctx/build.log" 2>&1 \
    || die "image build failed; see $ctx/build.log"
  echo "image ready: $SANDBOX_IMAGE"
}

cmd_setup() {
  [[ -x "$PF_HELPER" ]] || die "the privileged helper is not installed. Run: sudo ./install.sh"
  command -v container >/dev/null 2>&1 \
    || die "Apple 'container' CLI not found. Install it from https://github.com/apple/container/releases, then rerun"
  command -v pfctl >/dev/null 2>&1 || die "pfctl not found; this tool needs macOS"
  command -v openssl >/dev/null 2>&1 || die "openssl not found; it ships with macOS"
  command -v dig >/dev/null 2>&1 || die "dig not found; it ships with macOS"
  command -v python3 >/dev/null 2>&1 || die "python3 not found; install the Xcode Command Line Tools (xcode-select --install)"

  ensure_brew_pkg mitmdump mitmproxy

  mkdir -p "$CA_DIR"
  chmod 700 "$SANDBOX_HOME" "$CA_DIR"

  if [[ -f "$CA_DIR/ca.key" && -f "$CA_DIR/ca.crt" ]]; then
    echo "CA already exists: $CA_DIR/ca.crt"
  else
    openssl req -x509 -newkey rsa:2048 -nodes \
      -keyout "$CA_DIR/ca.key" -out "$CA_DIR/ca.crt" \
      -days 825 -subj "/CN=sandbox-local-ca-$(scutil --get LocalHostName 2>/dev/null || hostname -s)" \
      >/dev/null 2>&1
    chmod 600 "$CA_DIR/ca.key"
    chmod 644 "$CA_DIR/ca.crt"
    echo "created CA: $CA_DIR/ca.crt (private key: $CA_DIR/ca.key, owner-only)"
  fi

  write_helper
  build_image
  echo "ok: this Mac is set up. In a project folder, run: sandbox init"
}

# ---------------------------------------------------------------- networking helpers

candidate_subnets() {
  local used n
  used="$( {
    ifconfig 2>/dev/null | awk '/inet /{print $2}'
    netstat -rn -f inet 2>/dev/null | awk '{print $1}'
    container network list 2>/dev/null | awk 'NR>1{print $2}'
  } )"
  for n in $(seq 200 250); do
    if echo "$used" | grep -qE "^192\.168\.${n}[./]"; then
      continue
    fi
    echo "192.168.${n}.0/24"
  done
}

# Outbound test run before any pf rules exist: if this fails, the range isn't usable.
probe_network() {
  container run --rm --network "$1" "$SANDBOX_IMAGE" \
    sh -c 'nc -z -w 5 1.1.1.1 443 || nc -z -w 5 8.8.8.8 443' >/dev/null 2>&1
}

find_bridge() {
  local ip="$1"
  ifconfig | awk -v ip="$ip" '
    /^bridge[0-9]+:/ { iface = $1; sub(":", "", iface) }
    $1 == "inet" && $2 == ip { print iface; found = 1; exit }
    END { exit !found }
  ' || die "no bridge interface carries gateway $ip"
}

# Turns an address file into CIDR blocks. Accepts single addresses, a-b ranges, CIDR blocks,
# and a line reading "all" (every address). Refuses malformed entries, prefixes below /8,
# overlap with the sandbox subnet (unless subnet is "none"), and this Mac's own addresses.
normalize_ips() {
  local src="$1" subnet="$2" out="$3" own
  own="$(ifconfig | awk '$1=="inet"{print $2}' | paste -sd, -)"
  python3 - "$src" "$subnet" "$own" > "$out" <<'PYEOF' || die "the IP file has an invalid entry (see the message above)"
import ipaddress, sys
src, subnet, own_list = sys.argv[1], sys.argv[2], sys.argv[3]
box = None if subnet == "none" else ipaddress.IPv4Network(subnet)
own = [ipaddress.IPv4Address(x) for x in own_list.split(",") if x]
for raw in open(src):
    line = raw.split("#", 1)[0].replace(" ", "").replace("\t", "").strip().lower()
    if not line:
        continue
    if line == "all":
        print("0.0.0.0/0")
        continue
    try:
        if "-" in line:
            a, b = line.split("-", 1)
            nets = list(ipaddress.summarize_address_range(ipaddress.IPv4Address(a), ipaddress.IPv4Address(b)))
        else:
            nets = [ipaddress.IPv4Network(line, strict=False)]
    except ValueError:
        print(f"sandbox: invalid IP entry: {line}", file=sys.stderr)
        sys.exit(2)
    for n in nets:
        if n.prefixlen < 8:
            print(f"sandbox: {n} is too broad (prefix below /8); use 'all' to allow every address", file=sys.stderr)
            sys.exit(2)
        if box is not None and n.overlaps(box):
            print(f"sandbox: {n} overlaps the sandbox subnet", file=sys.stderr)
            sys.exit(2)
        for o in own:
            if o in n:
                print(f"sandbox: {n} contains this Mac's address {o}", file=sys.stderr)
                sys.exit(2)
        print(n)
PYEOF
}

# Checks a domain file before anything is created. Writes the cleaned list to $2.
check_domain_file() {
  local file="$1" out="$2" n=0 line
  local hostre='^\.?([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)*[a-z0-9]([a-z0-9-]*[a-z0-9])?\.?$'
  local ipre='^[0-9]+(\.[0-9]+){3}$'
  : > "$out"
  while IFS= read -r line || [[ -n "$line" ]]; do
    n=$((n + 1))
    line="${line%%#*}"
    line="$(printf '%s' "$line" | tr -d '[:space:]' | tr 'A-Z' 'a-z')"
    [[ -z "$line" ]] && continue
    if [[ "$line" == "all" ]]; then
      echo "all" >> "$out"
      continue
    fi
    if [[ "$line" =~ $ipre ]]; then
      die "domain file $file, line $n: '$line' is an IP address. Put addresses in an IP file (-i)"
    fi
    [[ "$line" =~ $hostre ]] || die "domain file $file, line $n: '$line' is not a valid host name"
    echo "$line" >> "$out"
  done < "$file"
  awk '!seen[$0]++' "$out" > "$out.tmp" && mv "$out.tmp" "$out"
}

# True when host $1 is allowed by the domain list $2 (exact name, a .suffix entry, or all).
host_listed() {
  local h="$1" f="$2" d
  grep -qx all "$f" && return 0
  while IFS= read -r d; do
    [[ "$h" == "$d" ]] && return 0
    [[ "$d" == .* && "$h" == *"$d" ]] && return 0
  done < "$f"
  return 1
}

# Checks a pinned-host file against the allowed list $2. Writes the cleaned list to $3.
# Pinned hosts pass through without decryption (no Host check, no header capture), so each one must already be allowed.
check_pinned_file() {
  local file="$1" allowed="$2" out="$3" h
  check_domain_file "$file" "$out.raw"
  : > "$out"
  while IFS= read -r h; do
    [[ "$h" == "all" ]] && die "pinned file $file: 'all' can't be pinned. List the hosts you need"
    host_listed "$h" "$allowed" || die "pinned file $file: '$h' is not in the domain list. Pin only allowed hosts"
    echo "$h" >> "$out"
  done < "$out.raw"
  rm -f "$out.raw"
}

# Upstream CA files may be PEM or DER (Burp exports DER). Squid needs PEM, so DER is converted on the way in.
check_upstream_ca() {
  if grep -q 'BEGIN CERTIFICATE' "$1"; then
    openssl x509 -noout -in "$1" >/dev/null 2>&1 || die "upstream CA '$1' is not a valid PEM certificate"
  else
    openssl x509 -inform DER -noout -in "$1" >/dev/null 2>&1 || die "upstream CA '$1' is neither a PEM nor a DER certificate"
  fi
}

store_upstream_ca() {
  if grep -q 'BEGIN CERTIFICATE' "$1"; then
    cp "$1" "$2"
  else
    openssl x509 -inform DER -in "$1" -out "$2"
  fi
}

# Warns when an upstream proxy is set but nothing is listening on it yet.
upstream_warning() {
  local spec="$1"
  if ! nc -z -w 2 "${spec%:*}" "${spec##*:}" 2>/dev/null; then
    echo "warning: nothing is listening on the upstream proxy $spec. Web requests fail until it starts"
  fi
}

# Explains a proxy failure when an upstream proxy is set. Prints nothing when no upstream is set.
upstream_hint() {
  local dir="$1" short="$2" spec
  [[ -s "$dir/upstream" ]] || return 0
  spec="$(cat "$dir/upstream")"
  if nc -z -w 2 "${spec%:*}" "${spec##*:}" 2>/dev/null; then
    echo "      the upstream proxy $spec is listening. If it is Burp, check that its CA is set (sandbox upstream $short $spec <ca.pem>) and that Intercept isn't holding requests"
  else
    echo "      the upstream proxy $spec is NOT listening, so web requests fail. Start the proxy's listener on that port (Burp: Proxy > Proxy listeners), or clear the upstream: sandbox upstream $short none"
  fi
}

# Checks an upstream proxy spec (host:port) before anything is changed.
check_upstream() {
  local spec="$1" port
  [[ "$spec" =~ ^[A-Za-z0-9._-]+:[0-9]{1,5}$ ]] || die "upstream must be host:port (got '$spec')"
  port="${spec##*:}"
  (( 10#$port >= 1 && 10#$port <= 65535 )) || die "upstream port out of range: $spec"
}

# ---------------------------------------------------------------- proxy and firewall

# The web proxy is mitmproxy: one process per sandbox, on the sandbox's gateway. The addon
# (~/.sandbox/bin/sbx_addon.py) enforces the lists and records headers and cookies.
ROOTS_PEM="$SANDBOX_HOME/roots.pem"

proxy_pids() {
  local pid
  pid="$(cat "$SB_BASE/$1/proxy.pid" 2>/dev/null || true)"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && echo "$pid"
  return 0
}

# The bundle mitmproxy checks upstream certificates against: this Mac's roots, plus the upstream proxy's CA
# when one is set (Burp's CA, for example).
proxy_trust_bundle() {
  local dir="$1" out="$1/mitm/upstream-trust.pem"
  cat "$ROOTS_PEM" > "$out"
  if [[ -s "$dir/upstream-ca.pem" ]]; then cat "$dir/upstream-ca.pem" >> "$out"; fi
  chmod 600 "$out"
  echo "$out"
}

# Starts the proxy for a sandbox, restarting it if it runs. Domain, pin and upstream changes go through here.
reload_or_start_proxy() {
  local name="$1" dir="$SB_BASE/$1" gateway trust
  local args=()
  gateway="$(json_field "$dir/state.json" gateway)"
  stop_proxy "$name"
  if nc -z "$gateway" "$PROXY_PORT" 2>/dev/null; then
    die "$gateway:$PROXY_PORT is already in use by another process (see: lsof -nP -iTCP:$PROXY_PORT -sTCP:LISTEN)"
  fi
  mkdir -p "$dir/mitm"
  chmod 700 "$dir/mitm"
  # mitmproxy signs certificates with the sandbox CA, so it reads the key and the certificate from one PEM file.
  cat "$CA_DIR/ca.key" "$CA_DIR/ca.crt" > "$dir/mitm/mitmproxy-ca.pem"
  chmod 600 "$dir/mitm/mitmproxy-ca.pem"
  trust="$(proxy_trust_bundle "$dir")"
  args=(--listen-host "$gateway" --listen-port "$PROXY_PORT" --set "confdir=$dir/mitm"
        --set "ssl_verify_upstream_trusted_ca=$trust" -s "$BIN_DIR/sbx_addon.py")
  if [[ -s "$dir/upstream" ]]; then
    args+=(--mode "upstream:http://$(cat "$dir/upstream")")
  fi
  SBX_DIR="$dir" nohup mitmdump "${args[@]}" >"$dir/proxy.out" 2>&1 &
  echo $! > "$dir/proxy.pid"
  for _ in $(seq 1 15); do
    if nc -z "$gateway" "$PROXY_PORT" 2>/dev/null && [[ -n "$(proxy_pids "$name")" ]]; then
      return 0
    fi
    sleep 1
  done
  echo "--- proxy.out ---" >&2
  tail -n 15 "$dir/proxy.out" >&2 2>/dev/null || true
  die "the proxy did not start; see $dir/proxy.out"
}

stop_proxy() {
  local pids
  pids="$(proxy_pids "$1")"
  if [[ -z "$pids" ]]; then rm -f "$SB_BASE/$1/proxy.pid"; return 0; fi
  kill $pids 2>/dev/null || true
  for _ in 1 2 3 4 5; do
    if [[ -z "$(proxy_pids "$1")" ]]; then rm -f "$SB_BASE/$1/proxy.pid"; return 0; fi
    sleep 1
  done
  kill -9 $pids 2>/dev/null || true
  rm -f "$SB_BASE/$1/proxy.pid"
}

load_pf_anchor() {
  local name="$1" dir="$SB_BASE/$1"
  local subnet gateway bridge mode cidr cidrs=()
  subnet="$(json_field "$dir/state.json" subnet)"
  gateway="$(json_field "$dir/state.json" gateway)"
  bridge="$(json_field "$dir/state.json" bridge)"
  mode="$(cat "$dir/access-mode")"
  if [[ "$mode" == "both" ]] && grep -qx all "$dir/domains.txt" 2>/dev/null \
     && grep -qx "0.0.0.0/0" "$dir/ips.txt" 2>/dev/null; then
    mode="both-open"
  fi
  [[ -x "$PF_HELPER" ]] || die "privileged helper missing; run: sudo ./install.sh"
  if [[ "$mode" != "web" ]]; then
    while IFS= read -r cidr; do
      [[ -n "$cidr" ]] && cidrs+=("$cidr")
    done < "$dir/ips.txt"
  fi
  local ui_arg="none"
  if [[ -f "$dir/ui" ]]; then ui_arg="$UI_PORT"; fi
  sudo -n "$PF_HELPER" load "$name" "$subnet" "$gateway" "$bridge" "$PROXY_PORT" "$mode" "$ui_arg" \
    ${cidrs[@]+"${cidrs[@]}"} >"$dir/pf.out" 2>&1 \
    || die "could not load pf rules for $name (see $dir/pf.out)"
  echo "pf rules loaded for $name ($mode mode)"
}

pf_show() {
  sudo -n "$PF_HELPER" show "$1" 2>/dev/null || true
}

flush_pf_anchor() {
  sudo "$PF_HELPER" flush "$1" >/dev/null 2>&1 || true
}

start_capture() {
  sudo -n "$PF_HELPER" capture-start "$1" "$SB_BASE/$1/pflog.txt" \
    || die "could not start the network log for $1"
}

stop_capture() {
  sudo -n "$PF_HELPER" capture-stop "$1" "$SB_BASE/$1/capture.pid" >/dev/null 2>&1 || true
}

# One line per flow for this sandbox, built from pf's log records.
network_flows() {
  local name="$1" file="$SB_BASE/$1/pflog.txt" gw
  [[ -s "$file" ]] || { echo "(no network records yet)"; return 0; }
  gw="$(json_field "$SB_BASE/$1/state.json" gateway)"
  awk -v tag="rule 0.sandbox-$name." -v gw="$gw" '
    index($0, tag) == 0 { next }
    {
      ts = $1
      line = $0
      sub(/^[^)]*\): /, "", line)
      split(line, f, " ")
      action = f[1]; src = f[5]; dst = f[7]; sub(/:$/, "", dst)
      if (gw != "" && index(src, gw ".") == 1) next
      proto = "other"
      if (f[8] ~ /^ICMP/) proto = "icmp"
      else if (f[8] == "UDP,") proto = "udp"
      else if (f[8] == "Flags") proto = "tcp"
      key = action " " proto " " src " -> " dst
      if (!(key in count)) {
        order[++n] = key
        first[key] = ts
        verdict[key] = (action == "block") ? "BLOCK" : "ALLOW"
        kind[key] = proto
        flow[key] = src " -> " dst
      }
      count[key]++
      last[key] = ts
    }
    END {
      for (i = 1; i <= n; i++) {
        k = order[i]
        printf "%s  %s  %-5s %-4s %s  x%d\n", first[k], last[k], verdict[k], kind[k], flow[k], count[k]
      }
    }
  ' "$file"
}

ip_all_warning() {
  if [[ -f "$1/domains.txt" ]] && grep -qx all "$1/domains.txt"; then
    echo "WARNING: 'all' is set for both lists. Every address is reachable, web ports included, so web traffic to any address bypasses the proxy and the domain check. This Mac and DNS stay blocked."
  else
    echo "WARNING: 'all' is set for addresses. Every address is reachable directly, on any port, including web ports. Web traffic to any address bypasses the proxy and the domain check. This Mac and DNS stay blocked."
  fi
}

# ---------------------------------------------------------------- sandbox lifecycle

rollback_up() {
  local rc=$?
  [[ -n "${UP_WORK:-}" ]] && rm -rf "$UP_WORK"
  [[ $rc -eq 0 ]] && return 0
  echo "sandbox: 'up $UP_NAME' failed (exit $rc); removing what it created" >&2
  stop_proxy "$UP_NAME"
  stop_capture "$UP_NAME"
  flush_pf_anchor "$UP_NAME"
  container rm -f "$UP_CONTAINER" >/dev/null 2>&1 || true
  if ! container network delete "$UP_NETWORK" >/dev/null 2>&1 \
     && container network list 2>/dev/null | awk '{print $1}' | grep -qx "$UP_NETWORK"; then
    echo "sandbox: network $UP_NETWORK could not be removed. This is a stale record in the container service." >&2
    echo "         Reboot your Mac, then run 'sandbox up' again." >&2
  fi
  if [[ "$UP_EXISTED" == "1" ]]; then
    # A committed sandbox folder: keep its lists, remove only what this attempt created.
    rm -f "$UP_DIR/state.json"
    echo "sandbox: your lists are kept in $UP_DIR" >&2
  elif [[ -d "$UP_DIR" ]]; then
    local failed="$(dirname "$SB_BASE")/failed"
    local kept="$failed/$UP_NAME-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$failed"
    mv "$UP_DIR" "$kept"
    echo "sandbox: logs from the failed attempt kept in $kept" >&2
  fi
}

# The sandbox interface: a web page on 127.0.0.1 (no password, as chosen) for working inside the sandbox.
# Right now it shows the sandbox's virtual desktop, where Chromium runs, through noVNC. Other panes can be
# added later under the same port. Anyone on this Mac can open it while the sandbox runs.
UI_PORT="${UI_PORT:-6080}"
start_ui() {
  # The VNC server listens on the container's loopback only. websockify serves noVNC on UI_PORT and bridges it.
  container exec -d "$1" sh -c 'Xvfb :99 -screen 0 1280x800x24 >/tmp/xvfb.log 2>&1 & sleep 1; x11vnc -display :99 -forever -shared -nopw -localhost -rfbport 5900 >/tmp/x11vnc.log 2>&1 & websockify --web /usr/share/novnc 6080 localhost:5900 >/tmp/novnc.log 2>&1' \
    || die "could not start the sandbox interface in $1"
}

cmd_ui() {
  require_sandbox "${1:-}"
  local dir="$DIR" url="http://127.0.0.1:$UI_PORT/vnc.html?autoconnect=true&resize=scale"
  [[ -f "$dir/ui" ]] || die "sandbox '$1' was started without the interface. Run: sandbox destroy $1, then: sandbox up $1 --ui"
  echo "sandbox interface: $url"
  echo "(no password, open only while this Mac is trusted. Browser is the first pane.)"
  open "$url" >/dev/null 2>&1 || true
}

cmd_up() {
  local short="${1:-}"
  shift || true
  [[ -n "$short" ]] || die "usage: sandbox up <name> [-m web|network|both] [-d <domains-file>] [-i <ips-file>] [-p <pinned-file>] [--upstream <host:port> [--upstream-ca <pem>]] [--no-defaults]"
  set_sandbox_names "$short"
  local name="$NAME" dir="$DIR"

  local mode="" mode_given=0 domains="" ips_src="" pin_src="" up_spec="" up_ca="" use_defaults=1 defaults_given=0
  local env_args=() env_file_src="" ui=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -m|--mode|-d|--domains|-i|--ips|-p|--pinned|--upstream|--upstream-ca|-e|--env|--env-file)
        [[ $# -ge 2 ]] || die "$1 needs a value"
        case "$1" in
          -m|--mode) mode="$2"; mode_given=1 ;;
          -d|--domains) domains="$2" ;;
          -p|--pinned) pin_src="$2" ;;
          --upstream) up_spec="$2" ;;
          --upstream-ca) up_ca="$2" ;;
          -e|--env) env_args+=("$2") ;;
          --env-file) env_file_src="$2" ;;
          *) ips_src="$2" ;;
        esac
        shift
        ;;
      --no-defaults) use_defaults=0; defaults_given=1 ;;
      --ui) ui=1 ;;
      *) die "unknown option: $1" ;;
    esac
    shift
  done

  [[ ! -f "$dir/state.json" ]] || die "sandbox '$short' is already running. Use 'sandbox down $short' and 'sandbox destroy $short' first"

  local existed=0
  if [[ -d "$dir" ]]; then
    existed=1
    # A folder that came with a project clone: use its committed lists and settings.
    if [[ $mode_given -eq 0 && -f "$dir/access-mode" ]]; then mode="$(cat "$dir/access-mode")"; fi
    if [[ -z "$domains" && -f "$dir/engagement.txt" ]]; then domains="$dir/engagement.txt"; fi
    if [[ -z "$ips_src" && -f "$dir/ips-source.txt" ]]; then ips_src="$dir/ips-source.txt"; fi
    if [[ -z "$pin_src" && -f "$dir/pinned.txt" ]]; then pin_src="$dir/pinned.txt"; fi
    if [[ -z "$up_spec" && -f "$dir/upstream" ]]; then up_spec="$(cat "$dir/upstream")"; fi
    if [[ -z "$up_ca" && -f "$dir/upstream-ca.pem" ]]; then up_ca="$dir/upstream-ca.pem"; fi
    if [[ -z "$env_file_src" && ${#env_args[@]} -eq 0 && -f "$dir/env" ]]; then env_file_src="$dir/env"; fi
    if [[ -f "$dir/ui" ]]; then ui=1; fi
    if [[ $defaults_given -eq 0 && -f "$dir/defaults" ]]; then use_defaults="$(cat "$dir/defaults")"; fi
  fi
  mode="${mode:-both}"

  case "$mode" in
    web|network|both) ;;
    *) die "--mode must be web, network or both (got '$mode')" ;;
  esac
  [[ "$mode" != "network" || -z "$domains" ]] || die "network mode has no proxy, so it doesn't use a domain file (-d). Use -m web or -m both"
  [[ "$mode" != "web" || -z "$ips_src" ]] || die "web mode has no raw traffic, so it doesn't use an IP file (-i). Use -m network or -m both"
  [[ -z "$domains" || -f "$domains" ]] || die "domain file not found: $domains"
  [[ -z "$ips_src" || -f "$ips_src" ]] || die "IP file not found: $ips_src"
  [[ "$mode" != "network" || -z "$pin_src" ]] || die "network mode has no proxy, so it doesn't use a pinned-host file (-p). Use -m web or -m both"
  [[ -z "$pin_src" || -f "$pin_src" ]] || die "pinned-host file not found: $pin_src"
  [[ -z "$up_spec" || "$mode" != "network" ]] || die "network mode has no proxy, so it doesn't use an upstream proxy (--upstream). Use -m web or -m both"
  [[ -z "$up_ca" || -n "$up_spec" ]] || die "--upstream-ca needs --upstream"
  [[ -z "$up_spec" ]] || check_upstream "$up_spec"
  if [[ -n "$up_ca" ]]; then
    [[ -f "$up_ca" ]] || die "upstream CA file not found: $up_ca"
    check_upstream_ca "$up_ca"
  fi
  [[ -f "$BIN_DIR/sbx_addon.py" && -f "$CA_DIR/ca.crt" ]] || die "this Mac isn't set up yet. Run: sudo ./install.sh"

  # Check every list before anything is created. A failed check creates nothing.
  # work is global on purpose: the EXIT trap runs after this function's locals are gone.
  work="$(mktemp -d)"
  trap 'rm -rf "$work"' EXIT
  : > "$work/engagement"
  [[ -z "$domains" ]] || check_domain_file "$domains" "$work/engagement"
  : > "$work/ips.txt"
  [[ -z "$ips_src" ]] || normalize_ips "$ips_src" none "$work/ips.txt"
  if [[ -n "$pin_src" ]]; then
    {
      [[ $use_defaults -eq 1 ]] && grep -vE '^[[:space:]]*(#|$)' "$DEFAULTS_FILE"
      cat "$work/engagement"
    } | awk '!seen[$0]++' > "$work/allowed"
    check_pinned_file "$pin_src" "$work/allowed" "$work/pinned"
  fi

  # Environment variables for the container. Later entries win: -e beats --env-file.
  # Values are never printed, because they may hold credentials.
  : > "$work/env"
  if [[ -n "$env_file_src" ]]; then
    [[ -f "$env_file_src" ]] || die "env file not found: $env_file_src"
    grep -vE '^[[:space:]]*(#|$)' "$env_file_src" >> "$work/env" || true
  fi
  if (( ${#env_args[@]} > 0 )); then printf '%s\n' "${env_args[@]}" >> "$work/env"; fi
  local env_line
  while IFS= read -r env_line; do
    [[ "$env_line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || die "environment entry must be NAME=VALUE (got a line with no name or '=')"
  done < "$work/env"

  UP_NAME="$name" UP_DIR="$dir" UP_CONTAINER="sbx-$name" UP_NETWORK="sbx-$name" UP_WORK="$work" UP_EXISTED="$existed"
  trap rollback_up EXIT

  local subnet="" candidate network="sbx-$name" container="sbx-$name"
  if container network list 2>/dev/null | awk '{print $1}' | grep -qx "$network"; then
    die "a leftover network named $network exists. Run 'sandbox destroy $short'. If it stays, the container service holds a stale record: reboot your Mac, then retry"
  fi
  if container list --all 2>/dev/null | awk '{print $1}' | grep -qx "$container"; then
    die "a leftover container named $container exists; run 'sandbox destroy $short' or remove it, then retry"
  fi
  while IFS= read -r candidate; do
    container network create "$network" --subnet "$candidate" >/dev/null 2>&1 || continue
    if probe_network "$network"; then
      subnet="$candidate"
      break
    fi
    echo "skipping $candidate: outbound test failed" >&2
    container network delete "$network" >/dev/null 2>&1 || true
  done < <(candidate_subnets)
  [[ -n "$subnet" ]] || die "no address range passed the outbound test; reboot, then run 'sandbox up' again"
  # Proxy defaults for web modes, then the operator's variables. For a repeated name, the last entry wins.
  local gateway_ip="${subnet%.0/24}.1" run_env=() kv
  local envfile="$work/run-env"
  : > "$envfile"
  if [[ "$mode" != "network" ]]; then
    printf '%s\n' "HTTP_PROXY=http://$gateway_ip:$PROXY_PORT" "http_proxy=http://$gateway_ip:$PROXY_PORT" \
      "HTTPS_PROXY=http://$gateway_ip:$PROXY_PORT" "https_proxy=http://$gateway_ip:$PROXY_PORT" \
      "NO_PROXY=localhost,127.0.0.1,::1" "no_proxy=localhost,127.0.0.1,::1" >> "$envfile"
  fi
  cat "$work/env" >> "$envfile"
  tail -r "$envfile" | awk -F= '!seen[$1]++' | tail -r > "$envfile.final"
  while IFS= read -r kv; do run_env+=(-e "$kv"); done < "$envfile.final"
  # Browser data (profile, cookies, headers, logins) is shared by every tool in the sandbox, at /root/browser.
  # It's mounted from the sandbox folder, so it survives down/start and goes into the archive on destroy.
  # It stays out of git.
  mkdir -p "$dir/browser" "$dir/sessions"
  chmod 700 "$dir/browser"
  chmod 755 "$dir/sessions"
  local publish=()
  if (( ui )); then publish=(-p "127.0.0.1:$UI_PORT:$UI_PORT"); fi
  container run -d --name "$container" --network "$network" \
    -v "$dir/browser:/root/browser" -v "$dir/sessions:/root/sessions:ro" ${publish[@]+"${publish[@]}"} ${run_env[@]+"${run_env[@]}"} "$SANDBOX_IMAGE" tail -f /dev/null >/dev/null \
    || die "failed to start container $container"
  if (( ui )); then start_ui "$container"; fi

  local gateway bridge
  gateway="$(container inspect "$container" | grep -o '"ipv4Gateway" : "[^"]*"' | head -1 | cut -d'"' -f4)"
  [[ -n "$gateway" ]] || die "could not read gateway IP for $container"
  bridge="$(find_bridge "$gateway")"

  mkdir -p "$dir"
  echo "$mode" > "$dir/access-mode"
  cp "$work/env" "$dir/env"
  chmod 600 "$dir/env"
  if (( ui )); then echo 1 > "$dir/ui"; else rm -f "$dir/ui"; fi

  if [[ "$mode" != "network" ]]; then
    cp "$work/engagement" "$dir/engagement.txt"
    echo "$use_defaults" > "$dir/defaults"
    {
      [[ $use_defaults -eq 1 ]] && grep -vE '^[[:space:]]*(#|$)' "$DEFAULTS_FILE"
      cat "$dir/engagement.txt"
    } | awk '!seen[$0]++' > "$dir/domains.txt"
    if [[ -n "$pin_src" ]]; then cp "$work/pinned" "$dir/pinned.txt"; else rm -f "$dir/pinned.txt"; fi
    if [[ -n "$up_spec" ]]; then echo "$up_spec" > "$dir/upstream"; else rm -f "$dir/upstream"; fi
    if [[ -n "$up_ca" && "$up_ca" != "$dir/upstream-ca.pem" ]]; then store_upstream_ca "$up_ca" "$dir/upstream-ca.pem"
    elif [[ -z "$up_ca" ]]; then rm -f "$dir/upstream-ca.pem"
    fi
  fi
  if [[ "$mode" != "web" ]]; then
    if [[ -n "$ips_src" && "$ips_src" != "$dir/ips-source.txt" ]]; then
      cp "$ips_src" "$dir/ips-source.txt"
    elif [[ -z "$ips_src" ]]; then
      : > "$dir/ips-source.txt"
    fi
    normalize_ips "$dir/ips-source.txt" "$subnet" "$dir/ips.txt"
  fi

  printf '{\n  "name": "%s",\n  "sandbox": "%s",\n  "project": "%s",\n  "network": "%s",\n  "subnet": "%s",\n  "container": "%s",\n  "gateway": "%s",\n  "bridge": "%s",\n  "created": "%s"\n}\n' \
    "$name" "$short" "$PROJECT_NAME" "$network" "$subnet" "$container" "$gateway" "$bridge" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$dir/state.json"

  if [[ "$mode" != "network" ]]; then
    reload_or_start_proxy "$name"
  fi
  load_pf_anchor "$name"
  if [[ "$mode" != "web" ]]; then
    start_capture "$name"
  fi

  echo
  echo "sandbox $short in project $PROJECT_NAME: container $container on $subnet, gateway $gateway, bridge $bridge"
  case "$mode" in
    web)
      echo "MODE web: only the domains in domains.txt are reachable, through the proxy."
      echo "          ping, nmap and traceroute are blocked."
      ;;
    network)
      echo "MODE network: ICMP, TCP and UDP to the addresses in ips.txt, on any port, web ports included."
      echo "          No proxy and no domain checks. Web traffic here is not checked by name."
      ;;
    both)
      echo "MODE both: web goes through the proxy and is checked by domain."
      echo "          ICMP and TCP/UDP on non-web ports go to the addresses in ips.txt."
      echo "          Web ports on those addresses are open to direct traffic too, so list only addresses you own or trust."
      ;;
  esac
  if [[ "$mode" != "network" ]]; then
    echo "proxy on $gateway:$PROXY_PORT"
    [[ -s "$dir/engagement.txt" ]] || echo "note: no domains were given, so no web traffic is allowed. Load some with: sandbox domain $short <file>"
    grep -qx all "$dir/domains.txt" && echo "WARNING: 'all' is set for domains. The proxy allows every hostname."
    if [[ -s "$dir/pinned.txt" ]]; then
      echo "pinned:    $(grep -c . "$dir/pinned.txt") host(s) pass through without decryption (not recorded in sessions)"
    fi
    if [[ -s "$dir/upstream" ]]; then
      echo "upstream:  web goes via $(cat "$dir/upstream") $([[ -s "$dir/upstream-ca.pem" ]] && echo "(CA trusted)" || echo "(no CA: upstream certificates must be publicly trusted)")"
      echo "           with an upstream, pinned hosts are decrypted too, so the upstream sees them"
      upstream_warning "$(cat "$dir/upstream")"
    fi
  fi
  if [[ "$mode" != "web" ]]; then
    [[ -s "$dir/ips.txt" ]] || echo "note: no addresses were given, so no raw traffic is allowed. Load some with: sandbox ip $short <file>"
    grep -qx "0.0.0.0/0" "$dir/ips.txt" && echo "$(ip_all_warning "$dir")"
  fi
  return 0
}

cmd_start() {
  require_sandbox "${1:-}"
  local dir="$DIR" name="$NAME" mode gateway bridge state
  mode="$(cat "$dir/access-mode")"
  gateway="$(json_field "$dir/state.json" gateway)"
  bridge="$(json_field "$dir/state.json" bridge)"

  state="$(container list --all 2>/dev/null | awk -v c="sbx-$name" '$1==c{print $5}')"
  [[ -n "$state" ]] || die "the container for $1 is missing; run 'sandbox destroy $1' and 'sandbox up' again"
  if [[ "$state" != "running" ]]; then
    container start "sbx-$name" >/dev/null || die "could not start the container sbx-$name"
    if [[ -f "$dir/ui" ]]; then start_ui "sbx-$name"; fi
  fi

  # The sandbox's address plan must still match what was saved, or its rules would apply to the wrong place.
  local now
  now="$(container inspect "sbx-$name" | grep -o '"ipv4Gateway" : "[^"]*"' | head -1 | cut -d'"' -f4)"
  [[ "$now" == "$gateway" ]] || die "the sandbox's gateway changed ($gateway -> ${now:-none}). Run 'sandbox destroy $1' and 'sandbox up' again"
  [[ "$(find_bridge "$gateway")" == "$bridge" ]] || die "the sandbox's bridge changed. Run 'sandbox destroy $1' and 'sandbox up' again"

  if [[ "$mode" != "network" ]]; then
    reload_or_start_proxy "$name"
  fi
  load_pf_anchor "$name"
  if [[ "$mode" != "web" ]]; then
    start_capture "$name"
  fi
  echo "sandbox ${1} started (mode $mode). Check it with: sandbox verify ${1}"
}


cmd_pin() {
  require_sandbox "${1:-}"
  local dir="$DIR" name="$NAME" file="${2:-}"
  # work is global so the EXIT trap can still see it
  [[ "$(cat "$dir/access-mode")" != "network" ]] || die "network mode has no proxy, so it has no pinned hosts"
  if [[ "$file" == "none" ]]; then
    rm -f "$dir/pinned.txt"
    reload_or_start_proxy "$name"
    echo "sandbox ${1}: pinned hosts cleared and the proxy reloaded"
    return 0
  fi
  [[ -f "$file" ]] || die "usage: sandbox pin <name> <pinned-file>|none"
  work="$(mktemp -d)"
  trap 'rm -rf "$work"' EXIT
  check_pinned_file "$file" "$dir/domains.txt" "$work/pinned"
  cp "$work/pinned" "$dir/pinned.txt"
  reload_or_start_proxy "$name"
  echo "sandbox ${1}: $(grep -c . "$dir/pinned.txt" || true) pinned host(s) loaded and the proxy reloaded"
  return 0
}

cmd_upstream() {
  require_sandbox "${1:-}"
  local dir="$DIR" name="$NAME" spec="${2:-}" ca="${3:-}"
  [[ "$(cat "$dir/access-mode")" != "network" ]] || die "network mode has no proxy, so it has no upstream proxy"
  if [[ "$spec" == "none" ]]; then
    rm -f "$dir/upstream" "$dir/upstream-ca.pem"
    reload_or_start_proxy "$name"
    echo "sandbox ${1}: upstream proxy removed and the proxy reloaded"
    return 0
  fi
  [[ -n "$spec" ]] || die "usage: sandbox upstream <name> <host:port>|none [<ca.pem>]"
  check_upstream "$spec"
  if [[ -n "$ca" ]]; then
    [[ -f "$ca" ]] || die "upstream CA file not found: $ca"
    check_upstream_ca "$ca"
  fi
  echo "$spec" > "$dir/upstream"
  if [[ -n "$ca" ]]; then store_upstream_ca "$ca" "$dir/upstream-ca.pem"; else rm -f "$dir/upstream-ca.pem"; fi
  reload_or_start_proxy "$name"
  echo "sandbox ${1}: web goes via $spec and the proxy reloaded"
  upstream_warning "$spec"
  [[ -n "$ca" ]] || echo "note: no CA given. The upstream proxy's certificates must be publicly trusted, or web requests will fail"
  return 0
}

cmd_domain() {
  require_sandbox "${1:-}"
  local dir="$DIR" name="$NAME" file="${2:-}"
  # work is global so the EXIT trap can still see it
  [[ "$(cat "$dir/access-mode")" != "network" ]] || die "network mode has no proxy, so it has no domain list"
  [[ -f "$file" ]] || die "usage: sandbox domain <name> <domains-file>"
  work="$(mktemp -d)"
  trap 'rm -rf "$work"' EXIT
  check_domain_file "$file" "$work/engagement"
  cp "$work/engagement" "$dir/engagement.txt"
  {
    [[ "$(cat "$dir/defaults" 2>/dev/null || echo 1)" == "1" ]] && grep -vE '^[[:space:]]*(#|$)' "$DEFAULTS_FILE"
    cat "$dir/engagement.txt"
  } | awk '!seen[$0]++' > "$dir/domains.txt"
  if [[ -s "$dir/pinned.txt" ]]; then
    local h
    : > "$work/pinned.kept"
    while IFS= read -r h; do
      if host_listed "$h" "$dir/domains.txt"; then
        echo "$h" >> "$work/pinned.kept"
      else
        echo "pinned host $h is no longer in the domain list, so it was removed from the pinned list"
      fi
    done < "$dir/pinned.txt"
    cp "$work/pinned.kept" "$dir/pinned.txt"
  fi
  reload_or_start_proxy "$name"
  echo "sandbox ${1}: $(grep -c . "$dir/domains.txt" || true) domain(s) loaded and the proxy reloaded"
  grep -qx all "$dir/domains.txt" && echo "WARNING: 'all' is set for domains. The proxy allows every hostname."
  return 0
}

cmd_ip() {
  require_sandbox "${1:-}"
  local dir="$DIR" name="$NAME" file="${2:-}" subnet
  [[ "$(cat "$dir/access-mode")" != "web" ]] || die "web mode has no raw traffic, so it has no IP list"
  [[ -f "$file" ]] || die "usage: sandbox ip <name> <ip-file>"
  subnet="$(json_field "$dir/state.json" subnet)"
  if [[ "$file" != "$dir/ips-source.txt" ]]; then cp "$file" "$dir/ips-source.txt"; fi
  normalize_ips "$dir/ips-source.txt" "$subnet" "$dir/ips.txt"
  load_pf_anchor "$name"
  echo "sandbox ${1}: $(grep -c . "$dir/ips.txt" || true) address block(s) loaded"
  grep -qx "0.0.0.0/0" "$dir/ips.txt" && echo "$(ip_all_warning "$dir")"
  return 0
}

cmd_status() {
  require_sandbox "${1:-}"
  local dir="$DIR" name="$NAME" state proxy rules
  state="$(container list --all 2>/dev/null | awk -v c="sbx-$name" '$1==c{print $5}')"
  proxy="$(proxy_pids "$name")"
  rules="$(pf_show "$name" | grep -c . || true)"
  echo "sandbox:   ${1} (project $PROJECT_NAME)"
  echo "mode:      $(cat "$dir/access-mode")"
  echo "container: ${state:-missing}"
  if [[ "$(cat "$dir/access-mode")" != "network" ]]; then
    if [[ -n "$proxy" ]]; then echo "proxy:     running (pid $proxy)"; else echo "proxy:     stopped"; fi
    echo "domains:   $(grep -cvE '^(#|$)' "$dir/domains.txt") allowed"
    if [[ -s "$dir/pinned.txt" ]]; then echo "pinned:    $(grep -c . "$dir/pinned.txt") host(s) pass through without decryption"; fi
    if [[ -s "$dir/upstream" ]]; then echo "upstream:  $(cat "$dir/upstream")$([[ -s "$dir/upstream-ca.pem" ]] && echo " (CA trusted)")"; fi
  else
    echo "proxy:     not used in this mode"
  fi
  if [[ -f "$dir/ips.txt" ]]; then
    echo "addresses: $(grep -c . "$dir/ips.txt" || true) block(s) in ips.txt"
  fi
  if [[ -f "$dir/env" ]]; then echo "env:       $(grep -c . "$dir/env" || true) variable(s) set (values not shown)"; fi
  echo "pf rules:  $rules loaded"
  echo "subnet:    $(json_field "$dir/state.json" subnet)  gateway: $(json_field "$dir/state.json" gateway)"
}

cmd_logs() {
  require_sandbox "${1:-}"
  local dir="$DIR" name="$NAME" mode follow=0
  mode="$(cat "$dir/access-mode")"
  [[ "${2:-}" == "-f" ]] && follow=1
  if [[ $follow -eq 1 ]]; then
    local files=()
    [[ -f "$dir/access.log" ]] && files+=("$dir/access.log")
    [[ -f "$dir/pflog.txt" ]] && files+=("$dir/pflog.txt")
    [[ ${#files[@]} -gt 0 ]] || die "this sandbox has no logs"
    tail -n 50 -f "${files[@]}"
    return
  fi
  if [[ "$mode" != "network" ]]; then
    echo "== web (proxy) =="
    if [[ -f "$dir/access.log" ]]; then
      tail -n 50 "$dir/access.log"
    else
      echo "(no web records yet)"
    fi
  fi
  if [[ "$mode" != "web" ]]; then
    [[ "$mode" == "both" ]] && echo
    echo "== network (pf) =="
    network_flows "$name" | tail -n 50
  fi
}

cmd_verify() {
  require_sandbox "${1:-}"
  local dir="$DIR" name="$NAME" mode gateway container="sbx-$NAME" failures=0
  mode="$(cat "$dir/access-mode")"
  gateway="$(json_field "$dir/state.json" gateway)"

  check() {
    local label="$1" ok="$2"
    if [[ "$ok" == "yes" ]]; then
      echo "PASS  $label"
    else
      echo "FAIL  $label"
      failures=$((failures + 1))
    fi
  }

  local code
  # pf blocks DNS over UDP port 53. Ask a resolver directly over UDP and see whether it answers.
  code="$(container exec "$container" sh -c "timeout 10 node -e \"const {Resolver}=require('dns');const r=new Resolver({timeout:3000,tries:1});r.setServers(['8.8.8.8']);r.resolve4('example.com',e=>console.log(e?'no-answer':'answered'))\" 2>/dev/null || echo no-answer" 2>/dev/null || true)"
  check "DNS over UDP is blocked (8.8.8.8)" "$([[ "$code" == *no-answer* ]] && echo yes || echo no)"
  # TCP 53 is closed by the same policy, except when ips.txt allows every address.
  if grep -qx "0.0.0.0/0" "$dir/ips.txt" 2>/dev/null; then
    echo "SKIP  DNS over TCP is blocked (ips.txt allows every address)"
  else
    code="$(container exec "$container" sh -c 'nc -z -w 3 8.8.8.8 53 && echo open || echo closed' 2>/dev/null || true)"
    check "DNS over TCP is blocked (8.8.8.8)" "$([[ "$code" == *closed* ]] && echo yes || echo no)"
  fi

  code="$(container exec "$container" sh -c "nc -z -w 3 $gateway 22 && echo open || echo closed" 2>/dev/null || true)"
  check "host SSH is unreachable from the sandbox" "$([[ "$code" == *closed* ]] && echo yes || echo no)"

  code="$(container exec "$container" sh -c 'nc -z -w 5 192.0.2.1 443 && echo open || echo closed' 2>/dev/null || true)"
  if [[ -f "$dir/ips.txt" ]] && grep -qx "0.0.0.0/0" "$dir/ips.txt"; then
    echo "SKIP  an address outside the policy is blocked (ips.txt allows every address)"
  else
    check "an address outside the sandbox policy is blocked" "$([[ "$code" == *closed* ]] && echo yes || echo no)"
  fi

  local rules
  rules="$(pf_show "$name")"
  check "pf default-deny rule is loaded" "$([[ "$rules" == *"block drop"* ]] && echo yes || echo no)"

  if [[ "$mode" != "network" ]]; then
    local allowed_host
    # Prefer a plain host. A .suffix entry only covers subdomains, so test a www. name under it.
    allowed_host="$(grep -vE '^(#|$|all$|\.)' "$dir/domains.txt" 2>/dev/null | head -1)"
    [[ -n "$allowed_host" ]] || allowed_host="$(grep -E '^\.' "$dir/domains.txt" 2>/dev/null | head -1 | sed 's/^\./www./')"
    if [[ -n "$allowed_host" ]]; then
      # A failed request (curl exit != 0, e.g. a dead upstream) counts as not allowed.
      code="$(container exec "$container" sh -c "h=\$(curl -sD - -o /dev/null -m 15 -x http://$gateway:$PROXY_PORT https://$allowed_host/) || { echo curl-failed; exit 0; }; printf '%s\n' \"\$h\" | grep -i '^x-squid-error' || echo allowed" 2>/dev/null || true)"
      local allowed_ok
      allowed_ok="$([[ "$code" == *allowed* ]] && echo yes || echo no)"
      check "proxy allows a listed host ($allowed_host)" "$allowed_ok"
      [[ "$allowed_ok" == "yes" ]] || upstream_hint "$dir" "${1}"
    else
      echo "SKIP  proxy allows a listed host (no domains are listed)"
    fi

    code="$(container exec "$container" sh -c "curl -sD - -o /dev/null -m 15 -x http://$gateway:$PROXY_PORT https://example.org/ | grep -i '^x-squid-error' || echo allowed" 2>/dev/null || true)"
    check "proxy refuses a host not in the list" "$([[ "$code" != *allowed* ]] && echo yes || echo no)"
    # The SNI is the first listed host and the Host header is a second listed host. The proxy must refuse it.
    local second_host
    second_host="$(grep -vE '^(#|$|all$|\.)' "$dir/domains.txt" 2>/dev/null | grep -vx "$allowed_host" | head -1)"
    if [[ -n "$allowed_host" && -n "$second_host" ]]; then
      code="$(container exec "$container" sh -c "curl -sD - -o /dev/null -m 15 -x http://$gateway:$PROXY_PORT -H 'Host: $second_host' https://$allowed_host/ | grep -i '^x-squid-error' || echo not-refused" 2>/dev/null || true)"
      check "SNI and Host must match (SNI $allowed_host, Host $second_host)" "$([[ "$(printf '%s' "$code" | tr 'A-Z' 'a-z')" == *x-squid-error* ]] && echo yes || echo no)"
    else
      echo "SKIP  SNI and Host must match (needs two listed hosts)"
    fi

    check "proxy is running" "$([[ -n "$(proxy_pids "$name")" ]] && echo yes || echo no)"
  fi

  if [[ "$mode" != "web" ]]; then
    local cap_pid
    cap_pid="$(cat "$dir/capture.pid" 2>/dev/null || true)"
    check "network log is recording" "$([[ -n "$cap_pid" ]] && ps -p "$cap_pid" >/dev/null 2>&1 && echo yes || echo no)"
  fi

  echo
  if [[ $failures -eq 0 ]]; then
    echo "all checks passed"
  else
    echo "$failures check(s) failed"
    return 1
  fi
}

cmd_down() {
  require_sandbox "${1:-}"
  stop_proxy "$NAME"
  stop_capture "$NAME"
  flush_pf_anchor "$NAME"
  container stop "sbx-$NAME" >/dev/null 2>&1 || true
  rm -f "$DIR/capture.pid"
  echo "sandbox ${1} stopped (state kept)"
}

cmd_destroy() {
  require_sandbox "${1:-}"
  local dir="$DIR" name="$NAME" archive leftovers=()
  cmd_down "$1" >/dev/null
  container rm -f "sbx-$name" >/dev/null 2>&1 || true
  container network delete "sbx-$name" >/dev/null 2>&1 || true

  container list --all 2>/dev/null | awk '{print $1}' | grep -qx "sbx-$name" && leftovers+=("container sbx-$name")
  container network list 2>/dev/null | awk '{print $1}' | grep -qx "sbx-$name" && leftovers+=("network sbx-$name")
  [[ -n "$(proxy_pids "$name")" ]] && leftovers+=("proxy process")
  [[ -n "$(pf_show "$name")" ]] && leftovers+=("pf rules")

  rm -rf "$dir/mitm"
  local archives
  archives="$(dirname "$SB_BASE")/archive"
  archive="$archives/$name-$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$archives"
  mv "$dir" "$archive"
  if [[ ${#leftovers[@]} -gt 0 ]]; then
    echo "sandbox ${1} destroyed, but these still exist: ${leftovers[*]}" >&2
    if [[ " ${leftovers[*]} " == *"network"* ]]; then
      echo "A network that won't delete is a stale record in the container service. Reboot your Mac to clear it." >&2
    fi
    echo "Logs are in $archive" >&2
    return 1
  fi
  echo "sandbox ${1} destroyed; logs and settings archived in $archive"
}

cmd_list() {
  local proj pname sb dir name short mode state proxy cap found=0 containers
  containers="$(container list --all 2>/dev/null | awk 'NR>1{print $1" "$5}')"
  printf '%-14s %-14s %-8s %-10s %-18s %-10s %s\n' PROJECT SANDBOX MODE CONTAINER SUBNET PROXY CAPTURE
  [[ -f "$PROJECTS_FILE" ]] || { echo "no projects yet. Create one with: sandbox init (in a project folder)"; return 0; }
  while IFS= read -r proj; do
    [[ -f "$proj/.sandbox/project.json" ]] || continue
    pname="$(json_field "$proj/.sandbox/project.json" name)"
    SB_BASE="$proj/.sandbox/sandboxes"
    for dir in "$SB_BASE"/*/; do
      [[ -f "$dir/state.json" ]] || continue
      found=1
      name="$(basename "$dir")"
      short="${name#"$pname"-}"
      mode="$(cat "$dir/access-mode" 2>/dev/null || echo unknown)"
      state="$(awk -v c="sbx-$name" '$1==c{print $2}' <<<"$containers")"
      if [[ "$mode" == "network" ]]; then
        proxy="n/a"
      elif [[ -n "$(proxy_pids "$name")" ]]; then
        proxy="running"
      else
        proxy="stopped"
      fi
      cap="n/a"
      if [[ -f "$dir/capture.pid" ]]; then
        if ps -p "$(cat "$dir/capture.pid")" >/dev/null 2>&1; then cap="running"; else cap="stopped"; fi
      fi
      printf '%-14s %-14s %-8s %-10s %-18s %-10s %s\n' "$pname" "$short" "$mode" "${state:-missing}" \
        "$(json_field "$dir/state.json" subnet)" "$proxy" "$cap"
    done
  done < "$PROJECTS_FILE"
  [[ $found -eq 1 ]] || echo "no sandboxes yet. Create one in a project folder with: sandbox up <name>"
  return 0
}

cmd_shell() {
  require_sandbox "${1:-}"
  local container="sbx-$NAME" state
  state="$(container list --all 2>/dev/null | awk -v c="$container" '$1==c{print $5}')"
  [[ -n "$state" ]] || die "the container for $1 is missing; run 'sandbox destroy $1' and 'sandbox up' again"
  [[ "$state" == "running" ]] || die "$1 is $state; its container is stopped. Start it with: sandbox start $1"
  container exec -it "$container" sh
}

usage() {
  cat <<'EOF'
usage: sandbox <command>

Once per Mac (the installer runs setup for you):
  setup                                       create the CA and the sandbox image

Once per project folder:
  init                                        make this folder a sandbox project

Inside a project (the project is found from the current folder):
  up <name> [-m web|network|both] [-d <file>] [-i <file>] [-p <file>] [--upstream <host:port> [--upstream-ca <pem>]] [--no-defaults]
        -m   mode, default both
        -d   domain file (web and both). Optional: an empty list is created if it's missing
        -i   IP file (network and both). Optional: an empty list is created if it's missing
        -p   pinned-host file (web and both). Hosts must also be in the domain list
        --upstream <host:port>    send web through another proxy, such as Burp (web and both)
        --upstream-ca <pem>       CA that the upstream proxy signs with, PEM or DER (needs --upstream)
        -e NAME=VALUE             environment variable for the sandbox (repeatable). Values are not printed
        --env-file <file>         NAME=VALUE lines. -e entries override it
        --ui                      start the sandbox interface on 127.0.0.1:6080 (no password) for manual logins
        --no-defaults             web and both only
  domain <name> <file>                        replace the domain list and reload the proxy (web and both)
  ip <name> <file>                            replace the IP list and reload the firewall (network and both)
  status <name>                               show mode, container, proxy and rules
  verify <name>                               run the containment checks (PASS/FAIL)
  shell <name>                                open a shell inside the sandbox
  ui <name>                                   open the sandbox interface in a browser (needs up --ui)
  pin <name> <file>|none                      hosts that pass through without decryption (web and both)
  upstream <name> <host:port>|none [<ca.pem>] send web through another proxy, such as Burp (web and both)
  logs <name> [-f]                            web decisions (proxy) and network decisions (pf)
  down <name>                                 stop the container, proxy and rules (keeps state)
  start <name>                                bring a stopped sandbox back up with its saved settings
  destroy <name>                              remove everything and archive logs and settings

Anywhere:
  list                                        list every sandbox in every project on this Mac

An empty domain or IP file allows nothing for that kind of traffic. A line reading 'all'
allows every hostname (domains) or every address (IPs). Use it deliberately.

Pinned hosts pass through without decryption, so they skip the Host check and aren't recorded
in the sessions file. Use them only for clients that reject decrypted traffic. Each one must
also be in the domain list.

Every listed host is decrypted, and its headers and cookies are recorded in
sessions/sessions.json (one block per domain). The folder is mounted read-only at /root/sessions.

With an upstream proxy set, every listed host is decrypted and checked by Host/SNI, and
pinned hosts are inspected too. The upstream must be listening, or web requests fail.
EOF
}

ensure_container_service() {
  container list >/dev/null 2>&1 && return 0
  echo "starting the container service (container system start)..." >&2
  container system start || die "could not start the container service; run 'container system start' and check its output"
  container list >/dev/null 2>&1 || die "the container service still isn't responding after 'container system start'"
}

case "${1:-}" in
  setup) ensure_container_service; cmd_setup ;;
  init) cmd_init ;;
  list) ensure_container_service; cmd_list ;;
  up) ensure_container_service; resolve_project; shift; cmd_up "$@" ;;
  domain) ensure_container_service; resolve_project; cmd_domain "${2:-}" "${3:-}" ;;
  ip) ensure_container_service; resolve_project; cmd_ip "${2:-}" "${3:-}" ;;
  pin) ensure_container_service; resolve_project; cmd_pin "${2:-}" "${3:-}" ;;
  upstream) ensure_container_service; resolve_project; cmd_upstream "${2:-}" "${3:-}" "${4:-}" ;;
  verify) ensure_container_service; resolve_project; cmd_verify "${2:-}" ;;
  status) ensure_container_service; resolve_project; cmd_status "${2:-}" ;;
  logs) resolve_project; cmd_logs "${2:-}" "${3:-}" ;;
  down) ensure_container_service; resolve_project; cmd_down "${2:-}" ;;
  start) ensure_container_service; resolve_project; cmd_start "${2:-}" ;;
  destroy) ensure_container_service; resolve_project; cmd_destroy "${2:-}" ;;
  shell) ensure_container_service; resolve_project; cmd_shell "${2:-}" ;;
  ui) resolve_project; cmd_ui "${2:-}" ;;
  ""|-h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
